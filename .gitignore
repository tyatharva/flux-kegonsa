# --- FastEddy source: NCAR v5.0.1 + fasteddy/patches, fetched by fasteddy/fetch.sh ---
# Pinned by fasteddy/UPSTREAM and verified against fasteddy/MANIFEST.sha256. Not vendored.
FastEddy-model-5.0.1/
# --- compiled GPU LPDM (docker/build_lpdm.sh builds it from lpdm/cuda/) ---
lib/

# --- Large binary input data: never committed. Provenance in data/README.md ---
*.zip
*.tar.gz
*.tif
*.tif.ovr
data/raw/
data/grid/
data/grid_cbl/
data/conus404/
data/hrrr/
results/soundings/
results/forcing/
pairs/

# --- LES output: regenerable, and far too large. Peak storage is one run. ---
# The dumps are named FE_<TAG>.<step>, so they have NO extension a pattern can catch --
# `*.nc` does not match `FE_WIN.49680`. Every directory that can hold them is listed by
# name. Getting this wrong put 22 GB of fields into git history on 2026-08-20.
runs/**/output/
runs/**/window/
runs/**/FE_RST.*
# Catch-all: any FastEddy dump anywhere, whatever directory it lands in.
FE_*.[0-9]
FE_*.[0-9][0-9]*
runs/**/output_binary/
runs/**/initial/
runs/**/ICBC/
*.nc
!scripts/**/*.json

# --- Build artifacts (FastEddy builds in-tree; belt and braces) ---
*.o
FastEddy
FastEddy_devlink.o

# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Editors / OS ---
.DS_Store
*.swp

# --- Local CodeGraph index ---
.codegraph/

# --- Stage 6 preprocessing products: regenerable from the DEM ---
*.bin
*.npy
data/case_grids/
data/smokelib/
results/corpus/
results/pick/
# ...except the production surface, which every corpus case reads (184 kB, tracked)
!data/grid30_raised/*

# --- generated per-case run directories: the corpus makes ~1825 of them ---
# The .in files under runs/ are tracked for the retired passes, which are the record.
# A corpus case's directory is regenerable from its sounding and is not.
runs/case_*/
runs/yr_*/
runs/e2e_*/
runs/c2_check/
runs/c2_roundtrip/
runs/g16_b6cbl/

# Seed-job scratch: the segment .in files the driver writes, and smoke-test copies.
# A job bundle is seed.in + manifest.json and nothing else.
seeds/*/smoke.in
seeds/*/seg*.in
# run.in is generated per invocation by bin/run_seed.sh (Nt, inPath/inFile and
# surflayer_wth substituted into seed.in); seed.in is the tracked source of truth.
seeds/*/run.in
seeds/*/output/
seeds/*/window/
# the 30 seed restarts (70 MB each) live on Hugging Face; the verdicts beside them are tracked
seeds/*/return/seed_restart.nc
seeds/*/return/*.log
runs/dryrun_test/
runs/skiptest/
runs/unchain_test/

# the generated corpus: the two .h5 files, the 1366 source .npz and the run logs live on
# Hugging Face (see docs/getting-started/data.md); the index, flags, provenance and README
# are tracked here beside them.
corpus/*.h5
corpus/pairs_npz/
corpus/logs/

# --- ML emulator: checkpoints (on Hugging Face), the Optuna study database and per-record
# caches are regenerable from ml/ + corpus/; the tracked record is results/ml/*.{json,tsv,md,png} ---
results/ml/ckpt/
results/ml/**/*.pt
results/ml/*.db
results/ml/*.db-journal
results/ml/cache/
results/ml/final/seed*/pred_val.npz
results/ml_cfm/**/*.pt
results/ml_cfm/**/samples_val.npz
results/ml_cfm/**/samples_*.npz
results/ml_cfm/cache/
results/ml_cfm/*.db
results/ml_cfm/.t0
results/ml_cfm/test/*.npz

# --- figure scripts write their PNGs beside the recipe; the tracked copies are figures/poster/ ---
results/ml_cfm/final_recipe/*.png

# mkdocs build output
site/
